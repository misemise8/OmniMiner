{
	"schemaVersion": 1,
	"id": "omniminer",
	"version": "${version}",
	"name": "OmniMiner",
	"description": "Break connected blocks with server-authoritative limits, previews, automatic collection, and optional Floodgate support.",
	"authors": [
		"Misemise"
	],
	"contact": {
		"homepage": "https://github.com/misemise8/OmniMiner",
		"sources": "https://github.com/misemise8/OmniMiner",
		"issues": "https://github.com/misemise8/OmniMiner/issues"
	},
	"license": "MIT",
	"icon": "assets/omniminer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.misemise.OmniMiner"
		],
		"client": [
			"net.misemise.client.OmniMinerClient"
		],
		"fabric-datagen": [
			"net.misemise.OmniMinerDataGenerator"
		],
		"modmenu": [
			"net.misemise.ClothConfig.ModMenuIntegration"
		]
	},
	"mixins": [
		"omniminer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": ">=15.0.140"
	},
	"suggests": {
		"modmenu": ">=11.0.4"
	}
}
